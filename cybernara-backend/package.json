{
  "name": "cybernara-backend",
  "version": "0.1.0-m0",
  "private": true,
  "type": "module",
  "description": "Cybernara backend modular monolith foundation.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/generate-openapi.mjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "test": "npm run lint && npm run typecheck && npm run unit && npm run arch:test && npm run migration:lint && npm run openapi:check",
    "arch:test": "node scripts/check-boundaries.mjs",
    "migration:lint": "node scripts/check-migration-conventions.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/check-openapi-current.mjs",
    "supabase:smoke": "node scripts/supabase-smoke.mjs",
    "worker:outbox": "tsx src/modules/outbox/worker/outbox-worker.ts",
    "sources:manifest": "node scripts/check-source-manifest.mjs",
    "content:validate": "tsx src/modules/framework-content/cli/validate-source-content.ts",
    "g01:backfill": "node scripts/backfill-g01-execution-graph.mjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.20",
    "@nestjs/core": "10.4.20",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/swagger": "8.1.1",
    "@supabase/supabase-js": "2.45.4",
    "@types/pdfkit": "^0.13.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.2",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/express": "5.0.0",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "ajv": "^8.17.1",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.8"
  },
  "packageManager": "npm@10.9.2"
}
