{
  "name": "cybernara-frontend",
  "version": "0.1.0-m0",
  "private": true,
  "description": "Cybernara frontend BFF and operational console.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-next-dirs.mjs && next build && npm run performance:budget",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "e2e": "playwright test",
    "test": "npm run lint && npm run typecheck && npm run unit && npm run arch:test && npm run contract:check && npm run traceability:check && npm run e2e",
    "arch:test": "node scripts/check-boundaries.mjs",
    "contract:generate": "node scripts/generate-api-client.mjs",
    "contract:check": "node scripts/check-api-client-current.mjs",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "traceability:check": "node scripts/check-traceability.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "@tanstack/react-query": "5.64.2",
    "next": "15.1.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "9.18.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.8"
  },
  "packageManager": "npm@10.9.2"
}
